generator client {
  provider = "prisma-client-js"
}

// Production: Neon Postgres — use direct DATABASE_URL + DIRECT_URL (see DEPLOY.md, NEON.md).
// Pooled (-pooler) URLs break Prisma interactive transactions used by wallet/arena.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id // Discord snowflake
  username      String?
  balance       Int       @default(1000)
  frozen        Boolean   @default(false)
  dailyStreak   Int       @default(0)
  lastDailyAt   DateTime?
  wins          Int       @default(0)
  losses        Int       @default(0)
  ties          Int       @default(0)
  biggestWin    Int       @default(0)
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ledgerEntries LedgerEntry[]
  gamesAsP1     GameSession[] @relation("PlayerOne")
  gamesAsP2     GameSession[] @relation("PlayerTwo")

  @@index([balance])
}

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  balance   Int
  reason    String
  gameId    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([gameId])
  @@index([reason])
}

model GameSession {
  id          String    @id @default(cuid())
  type        String // coinflip | coinflip_house | rps | blackjack | crash | highlow | slots | roulette
  status      String // pending | active | settled | cancelled | expired
  wager       Int
  playerOneId String
  playerOne   User      @relation("PlayerOne", fields: [playerOneId], references: [id], onDelete: Cascade)
  playerTwoId String?
  playerTwo   User?     @relation("PlayerTwo", fields: [playerTwoId], references: [id], onDelete: SetNull)
  winnerId    String?
  payload     String    @default("{}") // JSON blob for game-specific state
  channelId   String?
  messageId   String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, type])
  @@index([status, expiresAt])
  @@index([playerOneId, status])
  @@index([playerTwoId, status])
  @@index([type, updatedAt])
}

model Jackpot {
  id      Int @id @default(1)
  balance Int @default(0)
}

model GuildSettings {
  guildId             String @id
  bigWinChannelId     String?
  bigWinThreshold     Int    @default(500)
  arenaMasterRole     String?
  /// Default Inferno Games entry fee when `/hungergames new` omits entry_fee (0 = free).
  hgDefaultEntryFee   Int    @default(0)
  /// Default max tributes when `/hungergames new` omits max_players.
  hgDefaultMaxPlayers Int    @default(24)
  /// House-funded prize paid to the last tribute standing (seeded into prize pool).
  hgDefaultWinPrize   Int    @default(250)
  /// Cost in HCC for a dead tribute to revive during a live round.
  hgDefaultReviveCost Int    @default(50)
  /// Max paid revives per tribute per round.
  hgDefaultMaxRevives Int    @default(2)
}

model ArenaGame {
  id         String         @id @default(cuid())
  guildId    String
  channelId  String
  messageId  String?
  hostId     String
  status     String // signup | running | finished | cancelled
  phase      String         @default("signup")
  dayNumber  Int            @default(0)
  entryFee   Int            @default(0)
  prizePool  Int            @default(0)
  maxPlayers Int            @default(24)
  winPrize   Int            @default(250)
  reviveCost Int            @default(50)
  maxRevives Int            @default(2)
  winnerId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tributes   ArenaTribute[]

  @@index([guildId, status])
  @@index([channelId, status])
  @@index([status, updatedAt])
}

model ArenaTribute {
  id          String    @id @default(cuid())
  gameId      String
  game        ArenaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId      String
  displayName String
  alive       Boolean   @default(true)
  infected    Boolean   @default(false)
  kills       Int       @default(0)
  revivesUsed Int       @default(0)
  weapon      String    @default("none")
  diedDay     Int?
  diedPhase   String?
  deathText   String?
  joinedAt    DateTime  @default(now())

  @@unique([gameId, userId])
  @@index([gameId, alive])
  @@index([userId])
}
