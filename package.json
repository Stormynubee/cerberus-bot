{
  "name": "cerberus-bot",
  "version": "1.0.0",
  "description": "GreekBot — GreekGodBerry HellCatCoins Discord gambling bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "npm run db:push && npm start",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "discord",
    "bot",
    "gambling",
    "hellcatcoins",
    "greekgodberry"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
