# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild instantly while developing
DISCORD_GUILD_ID=

# Database — SQLite works out of the box. For production Postgres:
# DATABASE_URL="postgresql://cerberus:cerberus@localhost:5432/cerberus?schema=public"
DATABASE_URL="file:../data/cerberus.db"

# Optional Redis for distributed locks (falls back to in-memory if unset)
# REDIS_URL="redis://localhost:6379"

# One-shot: push assets/greekbot-avatar.png to Discord (then remove — rate limited)
# SYNC_BOT_AVATAR=1

# Economy tuning
STARTING_BALANCE=1000
DAILY_REWARD=250
MIN_BET=10
MAX_BET=25000
HG_EVENT_DELAY_MS=7500
HG_MIN_PLAYERS=4
HG_MAX_PLAYERS=24
BIG_WIN_THRESHOLD=500
NODE_ENV=development
