# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild instantly while developing
DISCORD_GUILD_ID=

# Text-command prefix (slash commands still work). Default: !
COMMAND_PREFIX=!

# Database — Neon Postgres (production). Get both URLs from Neon console → Connect.
# Direct endpoint required: wallet + Inferno Games use Prisma interactive transactions.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Laptop hosting (fresh local database; preserves Neon settings for later recovery):
# DATABASE_URL="postgresql://cerberus:cerberus@localhost:5432/cerberus?schema=public"
# DIRECT_URL="postgresql://cerberus:cerberus@localhost:5432/cerberus?schema=public"
# PORT=8787
# Unset HOSTING_ROLE and KEEP_ALIVE_URL while hosting locally.

# Authenticated, read-only live-state bridge for the Greek website.
# Keep this value only on the bot and Greek backend; never expose it in browser code.
PUBLIC_STATE_API_KEY=

# Optional Redis for distributed locks when running multiple bot instances
# REDIS_URL="redis://localhost:6379"

# One-shot: push assets/greekbot-avatar.png to Discord (then remove — rate limited)
# SYNC_BOT_AVATAR=1

# Economy tuning
STARTING_BALANCE=1000
DAILY_REWARD=10
DAILY_REWARD_VIP=20
MIN_BET=10
MAX_BET=25000
# Optional VIP role snowflake — same 20 HCC daily as Discord server boosters
# VIP_ROLE_ID=
CHALLENGE_TTL_SECONDS=60
HG_EVENT_DELAY_MS=7500
HG_MIN_PLAYERS=4
HG_MAX_PLAYERS=24
BIG_WIN_THRESHOLD=500
NODE_ENV=development
